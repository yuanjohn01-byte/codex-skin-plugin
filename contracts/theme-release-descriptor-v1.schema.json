{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuanjohn01-byte/codex-skin-plugin/blob/main/contracts/theme-release-descriptor-v1.schema.json",
  "title": "Codex Skin Theme release descriptor v1",
  "type": "object",
  "required": [
    "descriptorVersion",
    "themePublicId",
    "themeVersion",
    "schemaVersion",
    "manifestSha256",
    "packageSha256",
    "packageByteSize",
    "publishedAt",
    "signingKeyId"
  ],
  "properties": {
    "descriptorVersion": {
      "const": 1
    },
    "themePublicId": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "themeVersion": {
      "$ref": "#/$defs/semver"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "packageSha256": {
      "$ref": "#/$defs/sha256"
    },
    "packageByteSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 32
    },
    "signingKeyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

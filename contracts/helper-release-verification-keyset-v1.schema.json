{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuanjohn01-byte/codex-skin-plugin/blob/main/contracts/helper-release-verification-keyset-v1.schema.json",
  "title": "Codex Skin Helper release verification keyset v1",
  "type": "object",
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/key"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "object",
      "required": [
        "keyId",
        "algorithm",
        "usage",
        "publicKeyBase64",
        "notBefore",
        "notAfter",
        "status"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "usage": {
          "const": "helper-release"
        },
        "publicKeyBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "notBefore": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 32
        },
        "notAfter": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 32
        },
        "status": {
          "enum": ["active", "verify-only", "revoked"]
        }
      },
      "additionalProperties": false
    }
  }
}
